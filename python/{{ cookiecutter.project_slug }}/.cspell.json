{
  "allowCompoundWords": true,
  "cache": {
    "useCache": true
  },
  "caseSensitive": true,
  "dictionaries": [
    "en-US",
    "ignore-words"
  ],
  "dictionaryDefinitions": [
    {
      "addWords": true,
      "description": "Project-specific terms",
      "name": "ignore-words",
      "path": ".cspell.ignore-words.txt"
    }
  ],
  "ignorePaths": [
    ".git/",
    ".venv/",
    "dist/",
    "uv.lock",
    "LICENSE-APACHE",
    "LICENSE-MIT"
  ],
  "language": "en",
  "languageSettings": [
    {
      "languageId": "python",
      "locale": "en"
    }
  ],
  "useGitignore": true
}
