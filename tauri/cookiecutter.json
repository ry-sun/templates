{
  "project_name": "My Tauri App",
  "project_slug": "{{ cookiecutter.project_name | lower | replace('.', '') | replace(' ', '-') | replace('_', '-') }}",
  "description": "A Tauri desktop and mobile application.",
  "author_name": "Ryan Sun",
  "author_email": "ruiyangsun02@gmail.com",
  "github_username": "ry-sun",
  "bundle_identifier": "com.{{ cookiecutter.github_username | lower | replace('.', '') | replace('-', '') | replace('_', '') }}.{{ cookiecutter.project_slug | lower | replace('.', '') | replace('-', '') | replace('_', '') }}",
  "platform_scope": ["desktop", "mobile", "both"],
  "desktop_targets": ["all", "macos", "windows", "linux"],
  "mobile_targets": ["both", "android", "ios"],
  "ci_scope": ["checks", "full-builds"],
  "edition": ["2024", "2021"],
  "rust_version": "1.97",
  "toolchain": ["stable", "nightly"],
  "license": ["MIT OR Apache-2.0", "MIT", "Apache-2.0", "None"],
  "copyright_year": "2026",
  "enable_react_compiler": false,
  "shadcn_base_color": ["neutral", "zinc", "stone", "mauve", "olive", "mist", "taupe"],
  "include_cspell": true,
  "include_pre_commit": true,
  "include_github_actions": true,
  "include_dependabot": true,
  "init_git": true,
  "github_repository": ["none", "private", "public"],
  "__crate_name": "{{ cookiecutter.project_slug | replace('-', '_') }}",
  "__prompts__": {
    "project_name": "Human-readable application name",
    "project_slug": "Repository, pnpm package, and Cargo package name",
    "description": "Short application description",
    "author_name": "Author name",
    "author_email": "Author email",
    "github_username": "GitHub username or organization",
    "bundle_identifier": "Portable reverse-domain application identifier",
    "platform_scope": {
      "__prompt__": "Application platform scope",
      "desktop": "Desktop platforms",
      "mobile": "Mobile platforms",
      "both": "Desktop and mobile platforms"
    },
    "desktop_targets": {
      "__prompt__": "Desktop targets (ignored for mobile-only projects)",
      "all": "macOS, Windows, and Linux",
      "macos": "macOS",
      "windows": "Windows",
      "linux": "Linux"
    },
    "mobile_targets": {
      "__prompt__": "Mobile targets (ignored for desktop-only projects)",
      "both": "Android and iOS",
      "android": "Android",
      "ios": "iOS"
    },
    "ci_scope": {
      "__prompt__": "Generated GitHub Actions scope",
      "checks": "Fast frontend and Rust checks",
      "full-builds": "Checks and selected native builds"
    },
    "edition": "Rust edition",
    "rust_version": "Minimum supported Rust version (MSRV)",
    "toolchain": "Rust toolchain channel",
    "license": "Project license",
    "copyright_year": "Copyright year",
    "enable_react_compiler": "Enable React Compiler",
    "shadcn_base_color": "shadcn/ui base color",
    "include_cspell": "Include CSpell configuration",
    "include_pre_commit": "Include pre-commit configuration",
    "include_github_actions": "Include a GitHub Actions check workflow",
    "include_dependabot": "Include Dependabot configuration",
    "init_git": "Initialize Git and create an initial commit",
    "github_repository": {
      "__prompt__": "Publish generated project to GitHub",
      "none": "Do not publish",
      "private": "Create a private repository",
      "public": "Create a public repository"
    }
  }
}
